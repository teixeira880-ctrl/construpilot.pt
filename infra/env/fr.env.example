# Variáveis do backend construpilot.fr — copiar para infra/env/fr.env NA VM (permissões 600).
# Os valores atuais estão no painel da Emergent (Deployments → Environment). Nunca enviar para o GitHub.
#
# ── Novas variáveis da infraestrutura independente ─────────────────────────────
DB_NAME=construpilot_fr
STORAGE_BACKEND=s3+emergent      # durante a cópia dos ficheiros; depois: s3
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=construpilot-fr
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
SCHEDULER_ENABLED=false          # STAGING: false (nenhum e-mail / publicação / despesa automática). Produção: true
HEAVY_RENDER_CONCURRENCY=1       # renders 3D em simultâneo
WORKER_IDLE_MAX_S=10             # intervalo máximo entre consultas dos workers sem trabalho
SEED_DEMO_DATA=false
#
