+class WorkDraftIn(BaseModel):
+    kind: str = Field(pattern="^(email|report|action_plan)$")
+    title: str = Field(min_length=1, max_length=200, pattern=r"^[^\r\n\x00]+$")
+    recipient: str = Field(default="", max_length=250, pattern=r"^[^\r\n\x00]*$")
